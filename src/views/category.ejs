<%- include('partials/header') %>

<main>
    <h1><%= title %></h1>

    <h2><%= categoryDetails.category_name %></h2>

    <h3>Service Projects</h3>

    <% if (projects && projects.length > 0) { %>
        <ul>
            <% projects.forEach((project) => { %>
                <li>
                    <a href="/project/<%= project.project_id %>">
                        <%= project.title %>
                    </a>
                </li>
            <% }) %>
        </ul>
    <% } else { %>
        <p>No service projects available for this category.</p>
    <% } %>
    <p>
        <a href="/edit-category/<%= categoryDetails.category_id %>">
        Edit Category
        </a>
    </p>
</main>

<%- include('partials/footer') %>